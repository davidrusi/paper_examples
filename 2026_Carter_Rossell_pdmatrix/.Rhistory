run_simulations <- function(nsims, Theta, Sigma=solve(Theta), priorCoef, priorDiag, priorModel) {
mse = mse.cor = pp = mean_est = vector("list", nsims)
for (i in 1:nsims) {
# Simulate data
y = rmvnorm(n, sigma= Sigma)
sy = apply(y, 2, 'sd')
# Fit models
fit = modelSelectionGGM(y=y, priorCoef=priorCoef, priorDiag=priorDiag, priorModel=modelbinomprior(p=edge_prob), verbose=FALSE)
# Extract BMA parameter estimates and posterior edge inclusion probabilities
b= data.frame(coef(fit)) |>
select(row, column, estimate, margpp)
# Convert to original scale
scaling = 1 / (sy[b$row] * sy[b$column])
b = transform(b, estimate = estimate * scaling)
# Add data-generating truth
if (i==1) {
truth = double(nrow(b))
for (j in 1:nrow(b)) truth[j] = Theta[b$row[j], b$column[j]]
}
b$truth = truth
# Partial correlations
pc_est = cov2cor(icov(fit))
sel= upper.tri(pc_est)
b_pc= data.frame(row = row(pc_est)[sel], column = col(pc_est)[sel], estimate = pc_est[sel], truth = cov2cor(Theta)[sel])
# Record MSE, average posterior inclusion probability and average point estimate
mse[[i]] = group_by(b, truth) |>
summarize(mse = mean((truth - estimate)^2)) |>
cbind(simid = i)
pp[[i]] = group_by(b, truth) |>
summarize(pp = mean(margpp)) |>
cbind(simid = i)
mean_est[[i]] = group_by(b, truth) |>
summarize(estimate = mean(estimate)) |>
cbind(simid = i)
mse_pc[[i]] = group_by(b_pc, truth) |>
summarize(mse = mean((truth - estimate)^2)) |>
cbind(simid = i)
mean_est_pc[[i]] = group_by(b_pc, truth) |>
summarize(estimate = mean(estimate)) |>
cbind(simid = i)
cat('.')
}
ans = list(mse = mse, pp = pp, mean_est = mean_est)
return(ans)
}
